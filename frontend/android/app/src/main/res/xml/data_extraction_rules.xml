<?xml version="1.0" encoding="utf-8"?>
<!-- Nu copiem nimic în backup sau la transferul pe alt telefon: sesiunea (cookie-ul de autentificare) rămâne doar pe acest dispozitiv. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
