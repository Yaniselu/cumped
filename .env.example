# Copiază în .env și completează. Nu urca niciodată .env în git.

# Obligatoriu
DB_PASSWORD=schimba-ma
JWT_SECRET=genereaza-cu-openssl-rand-base64-48
PUBLIC_URL=https://cumped.com
CORS_ORIGINS=https://cumped.com
COOKIE_SECURE=true

# Cont de admin creat la pornire (minim 12 caractere)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Velo AI (opțional; fără cheie, Velo merge pe reguli)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Email pentru tichete (merg la contact@velosyntech.com)
SUPPORT_EMAIL=contact@velosyntech.com
MAIL_FROM=no-reply@cumped.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Login cu Google / Apple (client ID-uri, separate prin virgulă)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Doar pentru dezvoltare: simulează verificarea, SMS-ul și plățile + date demo
DEV_MODE=false
DEMO_DATA=false
